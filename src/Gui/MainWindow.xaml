<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinServBackup" Width="1060" Height="720" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#F4F5F7" Foreground="#1B1F24"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <!--STYLES-->
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Seitenleiste -->
        <Border Background="#FFFFFF" BorderBrush="#E3E6EA" BorderThickness="0,0,1,0">
            <Grid Margin="14,22,14,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="8,0,0,24">
                    <TextBlock Text="WinServBackup" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Sicherung für Windows Server und Clients" Foreground="#6A7280" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavOverview" Style="{StaticResource Nav}" GroupName="nav" Content="Übersicht" IsChecked="True"/>
                    <RadioButton x:Name="NavJobs" Style="{StaticResource Nav}" GroupName="nav" Content="Aufträge"/>
                    <RadioButton x:Name="NavRestore" Style="{StaticResource Nav}" GroupName="nav" Content="Wiederherstellung"/>
                    <RadioButton x:Name="NavLog" Style="{StaticResource Nav}" GroupName="nav" Content="Protokoll"/>
                </StackPanel>
                <TextBlock x:Name="VersionText" Grid.Row="2" Margin="8,0,0,0" Foreground="#9CA3AF" FontSize="12"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1">

            <!-- Übersicht -->
            <ScrollViewer x:Name="PageOverview" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,28,32,32">
                    <TextBlock Text="Übersicht" FontSize="26" FontWeight="SemiBold"/>

                    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="14" Height="14" Fill="#9CA3AF" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="StatusTitle" FontSize="18" FontWeight="SemiBold" Text="Wird geladen ..."/>
                                    <TextBlock x:Name="StatusSub" Foreground="#6A7280" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="BtnRunNow" Grid.Column="1" Style="{StaticResource Primary}" Content="Jetzt sichern" Padding="22,10" FontSize="15"/>
                        </Grid>
                    </Border>

                    <Border x:Name="RunCard" Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <Grid>
                                <TextBlock x:Name="RunPhase" FontWeight="SemiBold" Text="Sicherung läuft"/>
                                <TextBlock x:Name="RunPercent" HorizontalAlignment="Right" Foreground="#6A7280"/>
                            </Grid>
                            <ProgressBar x:Name="RunBar" Height="8" Margin="0,10,0,0" Minimum="0" Maximum="100" Foreground="#2563EB" Background="#E8EEFC" BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="LETZTE SICHERUNG" FontSize="11" Foreground="#6A7280" FontWeight="SemiBold"/>
                                <TextBlock x:Name="CardLastValue" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" Text="-"/>
                                <TextBlock x:Name="CardLastSub" Foreground="#6A7280" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Grid.Column="1" Margin="6,0,6,0">
                            <StackPanel>
                                <TextBlock Text="NÄCHSTE SICHERUNG" FontSize="11" Foreground="#6A7280" FontWeight="SemiBold"/>
                                <TextBlock x:Name="CardNextValue" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" Text="-"/>
                                <TextBlock x:Name="CardNextSub" Foreground="#6A7280" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Grid.Column="2" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="SPEICHERPLATZ IM ZIEL" FontSize="11" Foreground="#6A7280" FontWeight="SemiBold"/>
                                <TextBlock x:Name="CardSpaceValue" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" Text="-"/>
                                <TextBlock x:Name="CardSpaceSub" Foreground="#6A7280" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="Letzte Sicherungen" FontSize="16" FontWeight="SemiBold" Margin="0,28,0,10"/>
                    <Border Style="{StaticResource Card}" Padding="12,8">
                        <StackPanel>
                            <TextBlock x:Name="HistoryEmpty" Text="Noch keine Sicherung gelaufen." Foreground="#6A7280" Margin="8,10"/>
                            <ItemsControl x:Name="HistoryList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="10" Height="10" Fill="{Binding Color}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding When}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Size}" Foreground="#6A7280" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Duration}" Foreground="#6A7280" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Aufträge -->
            <ScrollViewer x:Name="PageJobs" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="32,28,32,32">
                    <Grid>
                        <TextBlock Text="Aufträge" FontSize="26" FontWeight="SemiBold"/>
                        <Button x:Name="BtnNewJob" Style="{StaticResource Primary}" Content="+ Neuer Auftrag" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBlock Text="Ein Auftrag legt fest, was wohin und wann gesichert wird." Foreground="#6A7280" Margin="0,6,0,0"/>

                    <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="10">
                        <StackPanel>
                            <TextBlock x:Name="JobsEmpty" Margin="10,12" Foreground="#6A7280" TextWrapping="Wrap"
                                       Text="Es gibt noch keinen Auftrag. Mit „Neuer Auftrag“ legen Sie die erste regelmäßige Sicherung an."/>
                            <ListBox x:Name="JobList" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource RowItem}" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/>
                                                    <TextBlock Text="{Binding StateText}" Foreground="{Binding StateColor}" Margin="10,2,0,0" FontSize="12" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Schedule}" Foreground="#4B5563" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding Detail}" Foreground="#6A7280" Margin="0,2,0,0" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Next}" Foreground="#6A7280" VerticalAlignment="Center" Margin="16,0,6,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <WrapPanel Margin="0,14,0,0">
                        <Button x:Name="BtnEditJob" Content="Bearbeiten" Margin="0,0,8,8"/>
                        <Button x:Name="BtnRunJob" Content="Jetzt ausführen" Margin="0,0,8,8"/>
                        <Button x:Name="BtnToggleJob" Content="Pausieren" Margin="0,0,8,8"/>
                        <Button x:Name="BtnDeleteJob" Style="{StaticResource Danger}" Content="Löschen" Margin="0,0,8,8"/>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Wiederherstellung -->
            <ScrollViewer x:Name="PageRestore" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="32,28,32,32">
                    <TextBlock Text="Wiederherstellung" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="Ein Backup ist eine einzelne .wim-Datei. Zum Zurückspielen starten Sie den Server vom Boot-Medium." Foreground="#6A7280" Margin="0,6,0,0" TextWrapping="Wrap"/>

                    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="1  Boot-Medium erstellen" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,6,0,0" Foreground="#4B5563" TextWrapping="Wrap"
                                       Text="Erzeugt eine startfähige Wiederherstellungsumgebung (WinPE) als ISO-Datei oder auf einem USB-Stick. Sie enthält den Wiederherstellungs-Assistenten und die Treiber dieses Servers. Einmal erstellen und sicher aufbewahren."/>
                            <Button x:Name="BtnMedia" Content="Boot-Medium erstellen ..." HorizontalAlignment="Left" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="2  So spielen Sie ein Backup ein" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,8,0,0" Foreground="#4B5563" TextWrapping="Wrap" LineHeight="22"
                                       Text="1. Server vom Boot-Medium starten (USB-Stick oder ISO).&#x0A;2. Der Assistent sucht die Backup-Dateien auf allen Laufwerken; Netzwerkfreigaben lassen sich verbinden.&#x0A;3. Backup und Zieldatenträger wählen, mit „WIEDERHERSTELLEN“ bestätigen. Der Zieldatenträger wird komplett überschrieben.&#x0A;4. Nach dem Neustart läuft der Server wie zum Zeitpunkt der Sicherung."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="3  Backup-Datei prüfen" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,6,0,0" Foreground="#4B5563" TextWrapping="Wrap" Text="Liest eine Backup-Datei und zeigt, was darin steckt, ohne etwas zu verändern."/>
                            <Button x:Name="BtnInspect" Content="Datei auswählen ..." HorizontalAlignment="Left" Margin="0,14,0,0"/>
                            <TextBlock x:Name="InspectResult" Margin="0,12,0,0" FontFamily="Consolas" FontSize="12.5" Foreground="#374151" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Protokoll -->
            <Grid x:Name="PageLog" Visibility="Collapsed" Margin="32,28,32,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Protokoll" FontSize="26" FontWeight="SemiBold"/>
                <Grid Grid.Row="1" Margin="0,16,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="LogSelect"/>
                    <Button x:Name="BtnOpenLogs" Grid.Column="1" Content="Ordner öffnen" Margin="8,0,0,0"/>
                </Grid>
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
                    <TextBox x:Name="LogText" IsReadOnly="True" BorderThickness="0" FontFamily="Consolas" FontSize="12.5"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" Background="Transparent"/>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</Window>
