<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auftrag" Width="620" Height="760" MinHeight="560" WindowStartupLocation="CenterOwner"
        Background="#F4F5F7" Foreground="#1B1F24" FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" ShowInTaskbar="False">
    <Window.Resources>
        <!--STYLES-->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6A7280"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,12">

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Head}" Text="Name"/>
                        <TextBox x:Name="JobName" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Head}" Text="Was wird gesichert?"/>
                        <RadioButton x:Name="RbAll" GroupName="vol" Content="Alle NTFS-Laufwerke (empfohlen für eine vollständige Wiederherstellung)" IsChecked="True" Margin="0,12,0,0"/>
                        <RadioButton x:Name="RbSome" GroupName="vol" Content="Nur bestimmte Laufwerke" Margin="0,8,0,0"/>
                        <StackPanel x:Name="VolumePanel" Margin="24,8,0,0" IsEnabled="False"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Head}" Text="Wohin?"/>
                        <TextBlock Style="{StaticResource Label}" Text="Ordner oder Netzwerkfreigabe (z. B. D:\Backups oder \\nas\backup\server1)"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TargetPath"/>
                            <Button x:Name="BtnBrowse" Grid.Column="1" Content="Durchsuchen ..." Margin="8,0,0,0"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Label}" Text="Nur für Netzwerkfreigaben mit Anmeldung (sonst leer lassen)"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TargetUser" Margin="0,0,4,0" ToolTip="Benutzername, z. B. DOMAIN\backup"/>
                            <PasswordBox x:Name="TargetPass" Grid.Column="1" Margin="4,0,0,0" ToolTip="Kennwort (wird verschlüsselt für diesen Server gespeichert)"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="BtnTestTarget" Content="Ziel testen"/>
                            <TextBlock x:Name="TargetTestResult" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Head}" Text="Wann?"/>
                        <ComboBox x:Name="ScheduleType" Margin="0,10,0,0">
                            <ComboBoxItem Tag="daily" Content="Täglich"/>
                            <ComboBoxItem Tag="weekly" Content="Wöchentlich"/>
                            <ComboBoxItem Tag="monthly" Content="Monatlich"/>
                            <ComboBoxItem Tag="hourly" Content="Alle paar Stunden"/>
                            <ComboBoxItem Tag="manual" Content="Nur manuell"/>
                        </ComboBox>
                        <StackPanel x:Name="RowTime">
                            <TextBlock Style="{StaticResource Label}" Text="Uhrzeit (HH:mm)"/>
                            <TextBox x:Name="TimeBox" Width="100" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel x:Name="RowHours">
                            <TextBlock Style="{StaticResource Label}" Text="Wiederholen alle ... Stunden (ab der Uhrzeit)"/>
                            <TextBox x:Name="HoursBox" Width="100" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel x:Name="RowDays">
                            <TextBlock Style="{StaticResource Label}" Text="Wochentage"/>
                            <WrapPanel x:Name="DaysPanel">
                                <ToggleButton Style="{StaticResource Pill}" Tag="Monday" Content="Mo"/>
                                <ToggleButton Style="{StaticResource Pill}" Tag="Tuesday" Content="Di"/>
                                <ToggleButton Style="{StaticResource Pill}" Tag="Wednesday" Content="Mi"/>
                                <ToggleButton Style="{StaticResource Pill}" Tag="Thursday" Content="Do"/>
                                <ToggleButton Style="{StaticResource Pill}" Tag="Friday" Content="Fr"/>
                                <ToggleButton Style="{StaticResource Pill}" Tag="Saturday" Content="Sa"/>
                                <ToggleButton Style="{StaticResource Pill}" Tag="Sunday" Content="So"/>
                            </WrapPanel>
                        </StackPanel>
                        <StackPanel x:Name="RowMonth">
                            <TextBlock Style="{StaticResource Label}" Text="Tag im Monat (1-31, oder „Letzter“)"/>
                            <ComboBox x:Name="DayOfMonthBox" Width="140" HorizontalAlignment="Left" IsEditable="False"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Head}" Text="Aufbewahrung und Größe"/>
                        <TextBlock Style="{StaticResource Label}" Text="So viele Sicherungen behalten (ältere werden nach einer erfolgreichen neuen gelöscht)"/>
                        <TextBox x:Name="KeepBox" Width="100" HorizontalAlignment="Left"/>
                        <TextBlock Style="{StaticResource Label}" Text="Komprimierung"/>
                        <ComboBox x:Name="CompBox" Width="320" HorizontalAlignment="Left">
                            <ComboBoxItem Tag="fast" Content="Schnell (empfohlen)"/>
                            <ComboBoxItem Tag="max" Content="Maximal (kleiner, deutlich langsamer)"/>
                            <ComboBoxItem Tag="none" Content="Keine (am schnellsten, am größten)"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <CheckBox x:Name="MailEnabled" Content="Per E-Mail benachrichtigen" FontWeight="SemiBold"/>
                        <StackPanel x:Name="MailPanel" IsEnabled="False">
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Style="{StaticResource Label}" Text="SMTP-Server"/>
                                    <TextBox x:Name="MailServer"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource Label}" Text="Port"/>
                                    <TextBox x:Name="MailPort"/>
                                </StackPanel>
                            </Grid>
                            <CheckBox x:Name="MailSsl" Content="Verschlüsselte Verbindung (SSL/TLS)" Margin="0,10,0,0"/>
                            <TextBlock Style="{StaticResource Label}" Text="Absender"/>
                            <TextBox x:Name="MailFrom"/>
                            <TextBlock Style="{StaticResource Label}" Text="Empfänger (mehrere mit Komma trennen)"/>
                            <TextBox x:Name="MailTo"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,4,0">
                                    <TextBlock Style="{StaticResource Label}" Text="SMTP-Benutzer (optional)"/>
                                    <TextBox x:Name="MailUser"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Style="{StaticResource Label}" Text="SMTP-Kennwort"/>
                                    <PasswordBox x:Name="MailPass"/>
                                </StackPanel>
                            </Grid>
                            <CheckBox x:Name="MailOnlyErr" Content="Nur bei Fehlern senden" Margin="0,12,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E3E6EA" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <TextBlock x:Name="ErrorText" Foreground="#B91C1C" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,200,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel" Content="Abbrechen" Margin="0,0,8,0"/>
                    <Button x:Name="BtnSave" Style="{StaticResource Primary}" Content="Speichern"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
