<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Boot-Medium erstellen" Width="560" Height="520" WindowStartupLocation="CenterOwner"
        Background="#F4F5F7" Foreground="#1B1F24" FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" ShowInTaskbar="False" ResizeMode="NoResize">
    <Window.Resources>
        <!--STYLES-->
    </Window.Resources>
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="Boot-Medium erstellen" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Foreground="#6A7280" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="Benötigt das Windows ADK mit dem WinPE-Add-on (kostenlos von Microsoft). Das Erstellen dauert einige Minuten und läuft in einem eigenen Fenster."/>

        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <RadioButton x:Name="RbIso" GroupName="m" Content="ISO-Datei (für virtuelle Server oder zum Brennen)" IsChecked="True"/>
                <Grid Margin="24,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="IsoPath"/>
                    <Button x:Name="BtnIsoBrowse" Grid.Column="1" Content="..." Margin="8,0,0,0" Padding="12,8"/>
                </Grid>
                <RadioButton x:Name="RbUsb" GroupName="m" Content="USB-Stick (wird dabei vollständig gelöscht)" Margin="0,16,0,0"/>
                <ComboBox x:Name="UsbCombo" Margin="24,8,0,0" IsEnabled="False"/>
            </StackPanel>
        </Border>

        <CheckBox x:Name="ChkDrivers" Content="Treiber dieses Servers einbinden (empfohlen)" IsChecked="True" Margin="0,16,0,0"/>
        <TextBlock Text="Tastaturlayout im Wiederherstellungs-System" Foreground="#6A7280" FontSize="12" Margin="0,12,0,4"/>
        <ComboBox x:Name="KbCombo" Width="240" HorizontalAlignment="Left">
            <ComboBoxItem Content="de-DE" IsSelected="True"/>
            <ComboBoxItem Content="de-AT"/>
            <ComboBoxItem Content="de-CH"/>
            <ComboBoxItem Content="en-US"/>
        </ComboBox>

        <TextBlock x:Name="MediaError" Foreground="#B91C1C" Margin="0,14,0,0" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnMediaCancel" Content="Abbrechen" Margin="0,0,8,0"/>
            <Button x:Name="BtnMediaCreate" Style="{StaticResource Primary}" Content="Erstellen"/>
        </StackPanel>
    </StackPanel>
</Window>
